# Copy to backend/.env and fill in. Never commit real keys.
# PROVIDER: "baseten" (Muse Spark Open, open weights) or "meta" (Meta Model API)
PROVIDER=baseten

# Baseten (open weights)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
OPEN_MODEL=meta-models/muse-spark-open-1026

# Meta Model API (only if PROVIDER=meta)
MODEL_API_KEY=
META_CHAT_MODEL=muse-spark-1.3

# Optional: free key from data.gov.in for live mandi prices (else sample data is used)
DATA_GOV_API_KEY=

# Optional tuning
# CACHE_TTL_S=600            # seconds to cache mandi/weather lookups (0 = off)
# RATE_AGENT_PER_MIN=12      # per-IP limit for agent/diagnose/ask
# RATE_VOICE_PER_MIN=20      # per-IP limit for transcribe/tts
# TRUSTED_PROXIES=1          # reverse proxies in front of the app (Render = 1); keeps the rate limit un-spoofable
# DEBUG_ENDPOINTS=0          # set 1 only while debugging a deployment

# WhatsApp channel (Meta Cloud API); leave empty to disable
# WHATSAPP_VERIFY_TOKEN=          # any string; paste the same in the Meta webhook settings
# WHATSAPP_ACCESS_TOKEN=          # temporary or System User token
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=            # verifies the X-Hub-Signature-256 header
# WHATSAPP_ALLOWED_NUMBERS=       # optional allow-list, e.g. 919876543210,15550001111
# WHATSAPP_VOICE_REPLY=1          # 0 = text replies only
