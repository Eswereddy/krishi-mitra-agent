# Copy to backend/.env and fill in. Never commit real keys.
# PROVIDER: "baseten" (Muse Spark Open, open weights) or "meta" (Meta Model API)
PROVIDER=baseten

# Baseten (open weights)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
OPEN_MODEL=meta-models/muse-spark-open-1026

# Meta Model API (only if PROVIDER=meta)
MODEL_API_KEY=
META_CHAT_MODEL=muse-spark-1.3
